{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Billing",
  "version": "0.1.0",
  "identifier": "app.billing.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @billing/desktop dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @billing/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Billing",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://*.supabase.co data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": ["icons/tile-mark-light.svg"]
  }
}
